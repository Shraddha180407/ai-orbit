generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  logoUrl             String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  aiModels            AIModel[]
  collectionCompanies CollectionCompany[]
  tools               Tool[]
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  emailVerified       DateTime?
  image               String?
  password            String?
  role                String               @default("USER")
  status              String               @default("ACTIVE")
  accounts            Account[]
  bookmarks           Bookmark[]
  collections         Collection[]
  collectionBookmarks CollectionBookmark[]
  linkBookmarks       LinkBookmark[]
  reportsAgainst      Report[]             @relation("ReportedUser")
  reportsMade         Report[]             @relation("Reporter")
  reviews             Review[]
  sessions            Session[]
  tasksCreated        Task[]               @relation("TaskCreator")
  taskBookmarks       TaskBookmark[]
  taskLikes           TaskLike[]           @relation("TaskLikeUser")
  taskSubscriptions   TaskSubscriber[]     @relation("TaskSubscriberUser")
  toolHistory         ToolHistory[]
  ToolVote            ToolVote[]
}

model Tool {
  id               String            @id @default(cuid())
  name             String
  description      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  avgRating        Float             @default(0)
  billingFrequency BillingFrequency  @default(NA)
  companyId        String?
  features         String[]          @default([])
  logoUrl          String?
  pricingAmount    Decimal?          @db.Decimal(10, 2)
  pricingModel     PricingModel
  reviewCount      Int               @default(0)
  screenshots      String[]          @default([])
  slug             String            @unique
  websiteUrl       String
  isOpenSource     Boolean           @default(false)
  isTrending       Boolean           @default(false)
  apiDocsUrl       String?
  compatibility    Platform[]
  cons             String[]          @default([])
  hasApi           Boolean           @default(false)
  performanceScore Float?
  pros             String[]          @default([])
  releaseDate      DateTime?
  targetUsers      UserPersona[]
  upvoteCount      Int               @default(0)
  verified         Boolean           @default(false)
  bookmarks        Bookmark[]
  collectionTools  CollectionTool[]
  reports          Report[]
  reviews          Review[]
  ttasks           TaskTool[]
  company          Company?          @relation(fields: [companyId], references: [id])
  categories       ToolCategory[]
  history          ToolHistory[]
  ToolIntegration  ToolIntegration[]
  tags             ToolTag[]
  ToolVote         ToolVote[]
  Tool_A           Tool[]            @relation("ToolAlternatives")
  Tool_B           Tool[]            @relation("ToolAlternatives")

  @@index([companyId])
  @@index([pricingModel])
  @@index([createdAt])
  @@index([avgRating])
  @@index([isTrending])
  @@index([releaseDate])
  @@index([verified])
}

model Category {
  id    String         @id @default(cuid())
  slug  String         @unique
  name  String
  tasks Task[]
  tools ToolCategory[]
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  tools ToolTag[]
}

model ToolCategory {
  toolId     String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([toolId, categoryId])
  @@index([categoryId])
}

model ToolTag {
  toolId String
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([toolId, tagId])
  @@index([tagId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  toolId    String
  userId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
  @@index([rating])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
}

model AIModel {
  id               String            @id @default(cuid())
  name             String
  creator          String
  contextWindow    String
  parameterSize    String
  modality         String
  releaseDate      String
  description      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  providerId       String?
  provider         Company?          @relation(fields: [providerId], references: [id])
  collectionModels CollectionModel[]
  tasks            TaskModel[]
  
  websiteUrl    String?
  capabilities  String[]  @default([])
  
  @@index([providerId])
}

model Publisher {
  id               String   @id @default(cuid())
  name             String
  domain           String   @unique
  website          String
  logoUrl          String?
  faviconUrl       String?
  colorHex         String?
  followersLabel   String?
  credibilityScore Float    @default(0.8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  articles         News[]

  @@index([name])
}

model Topic {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  articles  News[]   @relation("NewsToTopic")
}

model News {
  id          String         @id @default(cuid())
  title       String
  category    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  aiSummary   String
  articleUrl  String         @unique
  dek         String
  downvotes   Int            @default(0)
  filterTags  String[]       @default([])
  publisherId String
  slug        String         @unique
  upvotes     Int            @default(0)
  publishedAt DateTime
  publisher   Publisher      @relation(fields: [publisherId], references: [id])
  bookmarks   NewsBookmark[]
  comments    NewsComment[]
  votes       NewsVote[]
  reports     Report[]
  topics      Topic[]        @relation("NewsToTopic")

  @@index([publishedAt])
  @@index([publisherId])
  @@index([category])
}

model NewsBookmark {
  id        String   @id @default(cuid())
  articleId String
  clientId  String
  createdAt DateTime @default(now())
  article   News     @relation(fields: [articleId], references: [id])

  @@unique([articleId, clientId])
}

model NewsVote {
  id        String   @id @default(cuid())
  articleId String
  clientId  String
  value     Int
  createdAt DateTime @default(now())
  article   News     @relation(fields: [articleId], references: [id])

  @@unique([articleId, clientId])
}

model NewsComment {
  id         String   @id @default(cuid())
  articleId  String
  clientId   String
  authorName String   @default("Anonymous")
  body       String
  createdAt  DateTime @default(now())
  article    News     @relation(fields: [articleId], references: [id])

  @@index([articleId])
}

model Repository {
  id              String    @id @default(cuid())
  name            String
  owner           String
  stars           Int
  language        String?
  description     String?
  url             String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  brandColor      String?
  defaultBranch   String    @default("main")
  forks           Int
  githubCreatedAt DateTime
  githubId        Int       @unique
  homepage        String?
  license         String?
  logoUrl         String?
  openIssues      Int
  ownerAvatarUrl  String?
  readmeFetchedAt DateTime?
  readmeHtml      String?
  slug            String    @unique
  syncedAt        DateTime
  topics          String[]

  @@index([stars])
  @@index([language])
  @@index([topics], type: Gin)
  @@index([syncedAt])
}

model Video {
  id              String   @id @default(cuid())
  title           String
  publishedAt     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  accent          String
  authorAvatar    String
  authorName      String
  description     String
  durationSeconds Int
  likes           Int
  slug            String   @unique
  tags            String[] @default([])
  thumbnail       String
  toolCategory    String
  toolName        String
  youtubeId       String   @unique
  views           Int
  channelId       String?

  @@index([toolCategory])
  @@index([publishedAt])
  @@index([views])
}

model Robot {
  id           String      @id @default(cuid())
  name         String
  category     String
  manufacturer String
  year         String
  description  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  tasks        TaskRobot[]
}

model Device {
  id                  String       @id @default(cuid())
  name                String
  category            String
  manufacturer        String
  year                String
  description         String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  additionalInfo      String?
  aiFeatures          String[]     @default([])
  availability        Availability @default(Announced)
  buyUrl              String?
  country             String?
  formFactor          String?
  imageUrl            String
  mainTask            String
  manufacturerLogoUrl String
  month               String?
  price               String?
  primaryUseCases     String[]     @default([])
  ram                 String?
  slug                String       @unique
  tasks               TaskDevice[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LeaderboardCompany {
  id            String @id
  name          String
  rank          Int
  growth        Float
  funding       String
  headquarters  String
  productsCount Int
  modelsCount   Int
  votes         Int
  rating        Float
  saves         Int
  description   String
  visits        String
}

model LeaderboardModel {
  id             String  @id
  name           String
  provider       String
  category       String
  rank           Int
  growth         Float
  contextWindow  String
  pricing        String
  eloRating      Int
  benchmarkScore Float
  openSource     Boolean
  votes          Int
  rating         Float
  saves          Int
  description    String
  visits         String
}

model LeaderboardTool {
  id          String @id
  name        String
  category    String
  tags        String
  rank        Int
  growth      Float
  votes       Int
  rating      Float
  saves       Int
  url         String
  description String
  pricing     String
  visits      String
  addedDate   String
}

model ToolHistory {
  id       String   @id @default(cuid())
  userId   String
  toolId   String
  viewedAt DateTime @default(now())
  tool     Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
}

model Collection {
  id               String               @id @default(cuid())
  slug             String               @unique
  description      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  creatorId        String
  creatorType      CreatorType          @default(COMMUNITY)
  isCurated        Boolean              @default(false)
  isFeatured       Boolean              @default(false)
  name             String
  toolCount        Int                  @default(0)
  creator          User                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  bookmarks        CollectionBookmark[]
  categories       CollectionCategory[]
  relatedCompanies CollectionCompany[]
  relatedModels    CollectionModel[]
  tools            CollectionTool[]

  @@index([creatorId])
  @@index([isFeatured])
  @@index([updatedAt])
}

model CollectionCategory {
  id           String     @id @default(cuid())
  categoryName String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([categoryName])
}

model CollectionTool {
  id           String     @id @default(cuid())
  addedAt      DateTime   @default(now())
  collectionId String
  toolId       String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tool         Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([collectionId, toolId])
}

model CollectionModel {
  id           String     @id @default(cuid())
  collectionId String
  modelId      String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  model        AIModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([collectionId, modelId])
}

model CollectionCompany {
  id           String     @id @default(cuid())
  collectionId String
  companyId    String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([collectionId, companyId])
}

model CollectionBookmark {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  collectionId String
  userId       String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
}

model Task {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  description  String
  difficulty   TaskDifficulty   @default(EASY)
  pricingModel PricingModel     @default(FREE)
  isFeatured   Boolean          @default(false)
  categoryId   String
  creatorId    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  category     Category         @relation(fields: [categoryId], references: [id])
  creator      User?            @relation("TaskCreator", fields: [creatorId], references: [id])
  bookmarks    TaskBookmark[]
  devices      TaskDevice[]
  likes        TaskLike[]
  models       TaskModel[]
  resources    TaskResource[]
  robots       TaskRobot[]
  subscribers  TaskSubscriber[]
  tools        TaskTool[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([pricingModel])
  @@index([isFeatured])
  @@index([creatorId])
}

model TaskLike {
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("TaskLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskSubscriber {
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("TaskSubscriberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskModel {
  taskId  String
  modelId String
  model   AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, modelId])
  @@index([modelId])
}

model TaskRobot {
  taskId  String
  robotId String
  robot   Robot  @relation(fields: [robotId], references: [id], onDelete: Cascade)
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, robotId])
  @@index([robotId])
}

model TaskDevice {
  taskId   String
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, deviceId])
  @@index([deviceId])
}

model TaskResource {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  url       String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskTool {
  taskId String
  toolId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([taskId, toolId])
  @@index([toolId])
}

model TaskBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  taskId    String
  userId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Report {
  id             String   @id @default(cuid())
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  reporterId     String
  reportedUserId String?
  reportedToolId String?
  reportedNewsId String?
  reportedNews   News?    @relation(fields: [reportedNewsId], references: [id], onDelete: Cascade)
  reportedTool   Tool?    @relation(fields: [reportedToolId], references: [id], onDelete: Cascade)
  reportedUser   User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
}

model LinkBookmark {
  id        String   @id @default(cuid())
  title     String?
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Integration {
  id              String            @id
  slug            String            @unique
  name            String
  logoUrl         String?
  ToolIntegration ToolIntegration[]
}

model ToolIntegration {
  toolId        String
  integrationId String
  Integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  Tool          Tool        @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([toolId, integrationId])
  @@index([integrationId])
}

model ToolVote {
  userId    String
  toolId    String
  createdAt DateTime @default(now())
  Tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, toolId])
  @@index([toolId])
}

enum PricingModel {
  FREE
  FREEMIUM
  PAID
  FREE_TRIAL
}

enum BillingFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
  NA
}

enum Availability {
  Available
  PreOrder     @map("Pre-order")
  Announced
  Discontinued
}

enum CreatorType {
  EDITORIAL
  COMMUNITY
}

enum TaskDifficulty {
  EASY
  MEDIUM
  ADVANCED
}

enum Platform {
  WEB
  WINDOWS
  MACOS
  LINUX
  IOS
  ANDROID
  CHROME_EXTENSION
}

enum UserPersona {
  DEVELOPERS
  DESIGNERS
  STUDENTS
  MARKETERS
  WRITERS
  RESEARCHERS
  EDUCATORS
  SALES
  ENTERPRISE
  CONTENT_CREATORS
}
