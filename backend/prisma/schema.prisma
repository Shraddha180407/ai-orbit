generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum PricingModel {
  FREE
  FREEMIUM
  PAID
  FREE_TRIAL
}

enum BillingFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
  NA
}

// ---- Stub models owned by other modules ----
// Module 4 (Companies) and Module 11 (Auth) will extend these.
// Do not add fields here beyond what Module 3 needs for its relations.

model Company {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  logoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  collectionCompanies CollectionCompany[]
  tools               Tool[]
  aiModels            AIModel[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  role          String    @default("USER")
  status        String    @default("ACTIVE") // ACTIVE, BLOCKED
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  reviews             Review[]
  bookmarks           Bookmark[]
  accounts            Account[]
  sessions            Session[]
  toolHistory         ToolHistory[]
  collections         Collection[]
  collectionBookmarks CollectionBookmark[]
  taskBookmarks       TaskBookmark[]
    linkBookmarks       LinkBookmark[]

  reportsMade         Report[] @relation("Reporter")
  reportsAgainst      Report[] @relation("ReportedUser")
  tasksCreated        Task[]               @relation("TaskCreator")
  taskLikes           TaskLike[]           @relation("TaskLikeUser")
  taskSubscriptions   TaskSubscriber[]     @relation("TaskSubscriberUser")
}



// ---- Module 3: AI Tools ----

model Tool {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoUrl     String?
  description String
  websiteUrl  String
  screenshots String[] @default([])
  features    String[] @default([])

  pricingModel     PricingModel
  pricingAmount    Decimal?         @db.Decimal(10, 2)
  billingFrequency BillingFrequency @default(NA)

  isOpenSource Boolean @default(false)
  isTrending   Boolean @default(false)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  categories ToolCategory[]
  tags       ToolTag[]

  reviews     Review[]
  bookmarks   Bookmark[]
  reports     Report[]
  history     ToolHistory[]

  alternatives  Tool[]     @relation("ToolAlternatives")
  alternativeOf Tool[]     @relation("ToolAlternatives")
  ttasks        TaskTool[]

  // Denormalized for fast listing-page sort/display. Recomputed by the
  // reviews API on every create/update/delete — see lib/reviews.ts.
  avgRating   Float @default(0)
  reviewCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  collectionTools CollectionTool[]

  @@index([companyId])
  @@index([pricingModel])
  @@index([createdAt])
  @@index([avgRating])
}

model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String

  tools ToolCategory[]
  tasks Task[]
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  tools ToolTag[]
}

model ToolCategory {
  toolId     String
  categoryId String

  tool     Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([toolId, categoryId])
  @@index([categoryId])
}

model ToolTag {
  toolId String
  tagId  String

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([toolId, tagId])
  @@index([tagId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
  @@index([rating])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
}

model AIModel {
  id               String            @id @default(cuid())
  name             String
  creator          String
  contextWindow    String
  parameterSize    String
  modality         String
  releaseDate      String
  description      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  collectionModels CollectionModel[]
  tasks            TaskModel[]

  providerId String?
  provider   Company? @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

// ---- News module ----

model Publisher {
  id               String   @id @default(cuid())
  name             String
  domain           String   @unique
  website          String
  logoUrl          String?
  faviconUrl       String?
  colorHex         String?
  followersLabel   String?
  credibilityScore Float    @default(0.8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  articles News[]

  @@index([name])
}

model Topic {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  articles News[]
}

model News {
  id         String @id @default(cuid())
  slug       String @unique
  title      String
  dek        String
  aiSummary  String
  articleUrl String @unique

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id])

  category   String
  filterTags String[] @default([])
  topics     Topic[]

  publishedAt DateTime
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks NewsBookmark[]
  votes     NewsVote[]
  comments  NewsComment[]
  reports   Report[]

  @@index([publishedAt])
  @@index([publisherId])
  @@index([category])
}

model NewsBookmark {
  id        String   @id @default(cuid())
  articleId String
  article   News     @relation(fields: [articleId], references: [id])
  clientId  String
  createdAt DateTime @default(now())

  @@unique([articleId, clientId])
}

model NewsVote {
  id        String   @id @default(cuid())
  articleId String
  article   News     @relation(fields: [articleId], references: [id])
  clientId  String
  value     Int
  createdAt DateTime @default(now())

  @@unique([articleId, clientId])
}

model NewsComment {
  id         String   @id @default(cuid())
  articleId  String
  article    News     @relation(fields: [articleId], references: [id])
  clientId   String
  authorName String   @default("Anonymous")
  body       String
  createdAt  DateTime @default(now())

  @@index([articleId])
}

model Repository {
  id              String    @id @default(cuid())
  githubId        Int       @unique
  slug            String    @unique
  name            String
  owner           String
  ownerAvatarUrl  String?
  description     String?
  url             String
  homepage        String?
  language        String?
  license         String?
  topics          String[]
  stars           Int
  forks           Int
  openIssues      Int
  defaultBranch   String    @default("main")
  logoUrl         String?
  brandColor      String?
  readmeHtml      String?
  readmeFetchedAt DateTime?
  githubCreatedAt DateTime
  syncedAt        DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([stars])
  @@index([language])
  @@index([topics], type: Gin)
  @@index([syncedAt])
}

// Synced from live production DB via `prisma db pull` on 2026-07-12 — this
// Synced from live production DB via `prisma db pull` on 2026-07-19 — this
// model was migrated directly to prod by another module without ever being
// committed here. Kept verbatim; not owned by this module, do not alter.
model Video {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  toolName        String
  toolCategory    String // "multimodal-ai" | "robotics" | "agents" | "llm" | "general-ai"
  youtubeId       String   @unique
  thumbnail       String
  durationSeconds Int
  views           Int
  likes           Int
  publishedAt     String // ISO date, YYYY-MM-DD (slice(0,10) at ingest time)
  authorName      String
  authorAvatar    String
  channelId       String?
  tags            String[] @default([])
  accent          String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([toolCategory])
  @@index([publishedAt])
  @@index([views])
}

model Robot {
  id           String      @id @default(cuid())
  name         String
  category     String
  manufacturer String
  year         String
  description  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  tasks        TaskRobot[]
}

enum Availability {
  Available
  PreOrder     @map("Pre-order")
  Announced
  Discontinued
}

model Device {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  manufacturer      String
  category          String
  availability      Availability @default(Announced)
  price             String?
  year              String
  month             String?
  description       String
  imageUrl          String
  manufacturerLogoUrl String
  mainTask          String
  formFactor        String?
  country           String?
  ram               String?
  aiFeatures        String[] @default([])
  primaryUseCases   String[] @default([])
  additionalInfo    String?
  buyUrl            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  tasks              TaskDevice[]
}

// ---- Auth Module ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LeaderboardCompany {
  id            String @id
  name          String
  rank          Int
  growth        Float
  funding       String
  headquarters  String
  productsCount Int
  modelsCount   Int
  votes         Int
  rating        Float
  saves         Int
  description   String
  visits        String
}

model LeaderboardModel {
  id             String  @id
  name           String
  provider       String
  category       String
  rank           Int
  growth         Float
  contextWindow  String
  pricing        String
  eloRating      Int
  benchmarkScore Float
  openSource     Boolean
  votes          Int
  rating         Float
  saves          Int
  description    String
  visits         String
}

model LeaderboardTool {
  id          String @id
  name        String
  category    String
  tags        String
  rank        Int
  growth      Float
  votes       Int
  rating      Float
  saves       Int
  url         String
  description String
  pricing     String
  visits      String
  addedDate   String
}

model ToolHistory {
  id       String   @id @default(cuid())
  userId   String
  toolId   String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool     Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
}

// ---- Module: Collections ----

enum CreatorType {
  EDITORIAL
  COMMUNITY
}

model Collection {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  isFeatured  Boolean     @default(false)
  isCurated   Boolean     @default(false)
  creatorType CreatorType @default(COMMUNITY)
  toolCount   Int         @default(0)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories       CollectionCategory[]
  tools            CollectionTool[]
  relatedModels    CollectionModel[]
  relatedCompanies CollectionCompany[]
  bookmarks        CollectionBookmark[]

  @@index([creatorId])
  @@index([isFeatured])
  @@index([updatedAt])
}

model CollectionCategory {
  id           String @id @default(cuid())
  categoryName String

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([categoryName])
}

model CollectionTool {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([collectionId, toolId])
}

model CollectionModel {
  id String @id @default(cuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  modelId String
  model   AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([collectionId, modelId])
}

model CollectionCompany {
  id String @id @default(cuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([collectionId, companyId])
}

model CollectionBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
}
// ---- Module: Tasks ----

enum TaskDifficulty {
  EASY
  MEDIUM
  ADVANCED
}

model Task {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  description  String
  difficulty   TaskDifficulty @default(EASY)
  pricingModel PricingModel   @default(FREE)
  isFeatured   Boolean        @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  creatorId String?
  creator   User?   @relation("TaskCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  bookmarks   TaskBookmark[]
  likes       TaskLike[]
  subscribers TaskSubscriber[]
  tools       TaskTool[]
  models      TaskModel[]
  robots      TaskRobot[]
  devices     TaskDevice[]
  resources   TaskResource[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([pricingModel])
  @@index([isFeatured])
  @@index([creatorId])
}

model TaskLike {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskSubscriber {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskSubscriberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskModel {
  taskId  String
  modelId String

  task  Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([taskId, modelId])
  @@index([modelId])
}

model TaskRobot {
  taskId  String
  robotId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  robot Robot @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@id([taskId, robotId])
  @@index([robotId])
}

model TaskDevice {
  taskId   String
  deviceId String

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([taskId, deviceId])
  @@index([deviceId])
}

model TaskResource {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  url       String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskTool {
  taskId String
  toolId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([taskId, toolId])
  @@index([toolId])
}

model TaskBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Report {
  id             String   @id @default(cuid())
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  reporterId     String
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId String?
  reportedUser   User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  reportedToolId String?
  reportedTool   Tool?    @relation(fields: [reportedToolId], references: [id], onDelete: Cascade)

  reportedNewsId String?
  reportedNews   News?    @relation(fields: [reportedNewsId], references: [id], onDelete: Cascade)
}

model LinkBookmark {
  id        String   @id @default(cuid())
  title     String?
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
