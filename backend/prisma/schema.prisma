generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum PricingModel {
  FREE
  FREEMIUM
  PAID
  FREE_TRIAL
}

enum BillingFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
  NA
}

enum Platform {
  WEB
  WINDOWS
  MACOS
  LINUX
  IOS
  ANDROID
  CHROME_EXTENSION
}

enum UserPersona {
  DEVELOPERS
  DESIGNERS
  STUDENTS
  MARKETERS
  WRITERS
  RESEARCHERS
  EDUCATORS
  SALES
  ENTERPRISE
  CONTENT_CREATORS
}

enum CompanyType {
  AI_NATIVE
  MODEL_COMPANIES
  UNICORNS
  AI_MODEL_PROVIDERS
  INFRASTRUCTURE
  ENTERPRISE
  HEALTHCARE
  GENERATIVE_AI
  MARKETING
  DEVELOPER_TOOLS
  ROBOTICS
  EDUCATION
  OPEN_SOURCE
  FINANCE
}

// ---- Stub models owned by other modules ----
// Module 4 (Companies) and Module 11 (Auth) will extend these.
// Do not add fields here beyond what Module 3 needs for its relations.

model Company {
  id                 String      @id @default(cuid())
  slug               String      @unique
  name               String
  logoUrl            String?
  description        String?

  website            String?
  country            String?
  city               String?
  foundedYear        Int?

  type               CompanyType[] @default([])
  sector             String?

  verified           Boolean     @default(false)
  featured           Boolean     @default(false)

  valuation          BigInt?
  fundingRaised      BigInt?
  latestFundingRound String?
  employeeCount      Int?

  linkedinUrl        String?
  twitterUrl         String?

  views              Int         @default(0)
  upvotes            Int         @default(0)
  impressions        Int         @default(0)

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  collectionCompanies CollectionCompany[]
  tools              Tool[]
  aiModels           AIModel[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  role          String    @default("USER")
  status        String    @default("ACTIVE") // ACTIVE, BLOCKED
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  reviews             Review[]
  bookmarks           Bookmark[]
  accounts            Account[]
  sessions            Session[]
  toolHistory         ToolHistory[]
  collections         Collection[]
  collectionBookmarks CollectionBookmark[]
  taskBookmarks       TaskBookmark[]
  linkBookmarks       LinkBookmark[]

  reportsMade       Report[]         @relation("Reporter")
  reportsAgainst    Report[]         @relation("ReportedUser")
  tasksCreated      Task[]           @relation("TaskCreator")
  taskLikes         TaskLike[]       @relation("TaskLikeUser")
  taskSubscriptions TaskSubscriber[] @relation("TaskSubscriberUser")
  toolVotes         ToolVote[]
  
  // MCP Directory relations
  mcpReviews        MCPDirectoryReview[]
  mcpDiscussions    MCPDirectoryDiscussion[]
  mcpDiscussionReplies MCPDirectoryDiscussionReply[]
  mcpUpvotes        MCPDirectoryUpvote[]
  mcpSavedItems     MCPDirectorySavedMCP[]
  mcpClaims         MCPDirectoryClaim[]
  mcpReports        MCPDirectoryReport[]
}

// ---- Module 3: AI Tools ----

model Tool {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  logoUrl     String?
  description String
  websiteUrl  String

  screenshots String[] @default([])
  features    String[] @default([])
  pros        String[] @default([])
  cons        String[] @default([])

  releaseDate DateTime?

  pricingModel     PricingModel
  pricingAmount    Decimal?         @db.Decimal(10, 2)
  billingFrequency BillingFrequency @default(NA)

  isOpenSource Boolean @default(false)
  isTrending   Boolean @default(false)
  verified     Boolean @default(false)

  compatibility Platform[]
  targetUsers   UserPersona[]

  hasApi     Boolean @default(false)
  apiDocsUrl String?

  performanceScore Float?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  categories   ToolCategory[]
  tags         ToolTag[]
  integrations ToolIntegration[]

  reviews   Review[]
  bookmarks Bookmark[]
  reports   Report[]
  history   ToolHistory[]

  alternatives  Tool[]     @relation("ToolAlternatives")
  alternativeOf Tool[]     @relation("ToolAlternatives")
  ttasks        TaskTool[]

  // Denormalized for fast listing-page sort/display. Recomputed by the
  // reviews API on every create/update/delete — see lib/reviews.ts.
  avgRating   Float @default(0)
  reviewCount Int   @default(0)

  upvoteCount Int        @default(0)
  votes       ToolVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  collectionTools CollectionTool[]

  @@index([companyId])
  @@index([pricingModel])
  @@index([createdAt])
  @@index([avgRating])
  @@index([releaseDate])
  @@index([isTrending])
  @@index([verified])
}

model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String

  tools ToolCategory[]
  tasks Task[]
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  tools ToolTag[]
}

model ToolCategory {
  toolId     String
  categoryId String

  tool     Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([toolId, categoryId])
  @@index([categoryId])
}

model ToolTag {
  toolId String
  tagId  String

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([toolId, tagId])
  @@index([tagId])
}

model Integration {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  logoUrl String?

  tools ToolIntegration[]
}

model ToolIntegration {
  toolId        String
  integrationId String

  tool        Tool        @relation(fields: [toolId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([toolId, integrationId])
  @@index([integrationId])
}

model ToolVote {
  userId String
  toolId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, toolId])
  @@index([toolId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
  @@index([rating])
}

model Bookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
}
enum ModelType {
  TEXT
  IMAGE
  VIDEO
  MULTIMODAL
  AUDIO
  CODE
  THREE_D
  STRUCTURED_DATA
}
model AIModel {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  creator          String
  contextWindow    String
  parameterSize    String
  modality         String
  releaseDate      String
  description      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  collectionModels CollectionModel[]
  tasks            TaskModel[]
  providerId String?
  provider   Company? @relation(fields: [providerId], references: [id])
  websiteUrl    String?
  capabilities  String[]  @default([])

  apiAvailable  Boolean     @default(false)
  documentation Json?
  promptExamples String[]   @default([])
  openSource    Boolean     @default(false)
  primaryTask   String?
  modelType     ModelType?
  @@index([providerId])
}

// ---- News module ----

model Publisher {
  id               String   @id @default(cuid())
  name             String
  domain           String   @unique
  website          String
  logoUrl          String?
  faviconUrl       String?
  colorHex         String?
  followersLabel   String?
  credibilityScore Float    @default(0.8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  articles News[]

  @@index([name])
}

model Topic {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  articles News[]
}

model News {
  id         String @id @default(cuid())
  slug       String @unique
  title      String
  dek        String
  aiSummary  String
  articleUrl String @unique

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id])

  category   String
  filterTags String[] @default([])
  topics     Topic[]

  publishedAt DateTime
  upvotes     Int      @default(0)
  downvotes   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks NewsBookmark[]
  votes     NewsVote[]
  comments  NewsComment[]
  reports   Report[]

  @@index([publishedAt])
  @@index([publisherId])
  @@index([category])
}

model NewsBookmark {
  id        String   @id @default(cuid())
  articleId String
  article   News     @relation(fields: [articleId], references: [id])
  clientId  String
  createdAt DateTime @default(now())

  @@unique([articleId, clientId])
}

model NewsVote {
  id        String   @id @default(cuid())
  articleId String
  article   News     @relation(fields: [articleId], references: [id])
  clientId  String
  value     Int
  createdAt DateTime @default(now())

  @@unique([articleId, clientId])
}

model NewsComment {
  id         String   @id @default(cuid())
  articleId  String
  article    News     @relation(fields: [articleId], references: [id])
  clientId   String
  authorName String   @default("Anonymous")
  body       String
  createdAt  DateTime @default(now())

  @@index([articleId])
}

model Repository {
  id              String    @id @default(cuid())
  githubId        Int       @unique
  slug            String    @unique
  name            String
  owner           String
  ownerAvatarUrl  String?
  description     String?
  url             String
  homepage        String?
  language        String?
  license         String?
  topics          String[]
  stars           Int
  forks           Int
  openIssues      Int
  defaultBranch   String    @default("main")
  logoUrl         String?
  brandColor      String?
  githubCreatedAt DateTime
  syncedAt        DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([stars])
  @@index([language])
  @@index([topics], type: Gin)
  @@index([syncedAt])
}

// Synced from live production DB via `prisma db pull` on 2026-07-12 — this
// Synced from live production DB via `prisma db pull` on 2026-07-19 — this
// model was migrated directly to prod by another module without ever being
// committed here. Kept verbatim; not owned by this module, do not alter.
model Video {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String
  toolName        String
  toolCategory    String // "multimodal-ai" | "robotics" | "agents" | "llm" | "general-ai"
  youtubeId       String   @unique
  thumbnail       String
  durationSeconds Int
  views           Int
  likes           Int
  publishedAt     String // ISO date, YYYY-MM-DD (slice(0,10) at ingest time)
  authorName      String
  authorAvatar    String
  channelId       String?
  tags            String[] @default([])
  accent          String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([toolCategory])
  @@index([publishedAt])
  @@index([views])
}

enum RobotCategory {
  HUMANOID
  MOBILE
  MANIPULATOR
  DRONE
  INDUSTRIAL
  WAREHOUSE
  HEALTHCARE
  HOME
  AGRICULTURAL
  DEFENSE
  SERVICE
  COMPANION
  OTHER
}

enum RobotAvailability {
  ANNOUNCED
  COMMERCIALLY_AVAILABLE
  DISCONTINUED
  IN_DEVELOPMENT
  IN_PRODUCTION
  PAUSED
  PILOT
  PRE_ORDER
  PROTOTYPE
}

enum AutonomyLevel {
  TELEOPERATED
  ASSISTED
  SEMI_AUTONOMOUS
  HIGHLY_AUTONOMOUS
  FULLY_AUTONOMOUS
}

model Robot {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  logoUrl         String?
  thumbnailUrl    String?
  company         String
  country         String
  category        RobotCategory
  availability    RobotAvailability
  price           String?
  releaseDate     String?
  mainTask        String?
  autonomyLevel   AutonomyLevel?
  primaryUseCases String[]
  websiteUrl      String?
  about           String?
  specs           String?
  mediaUrls       String[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tasks           TaskRobot[]
}

enum Availability {
  Available
  PreOrder     @map("Pre-order")
  Announced
  Discontinued
}

model Device {
  id                  String       @id @default(cuid())
  name                String
  slug                String       @unique
  manufacturer        String
  category            String
  availability        Availability @default(Announced)
  price               String?
  year                String
  month               String?
  description         String
  imageUrl            String
  images              String[]     @default([])
  videoUrl            String?
  manufacturerLogoUrl String
  mainTask            String
  formFactor          String?
  country             String?
  ram                 String?
  aiFeatures          String[]     @default([])
  primaryUseCases     String[]     @default([])
  additionalInfo      String?
  buyUrl              String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  tasks               TaskDevice[]
}

// ---- Auth Module ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LeaderboardCompany {
  id            String @id
  name          String
  rank          Int
  growth        Float
  funding       String
  headquarters  String
  productsCount Int
  modelsCount   Int
  votes         Int
  rating        Float
  saves         Int
  description   String
  visits        String
}

model LeaderboardModel {
  id             String  @id
  name           String
  provider       String
  category       String
  rank           Int
  growth         Float
  contextWindow  String
  pricing        String
  eloRating      Int
  benchmarkScore Float
  openSource     Boolean
  votes          Int
  rating         Float
  saves          Int
  description    String
  visits         String
}

model LeaderboardTool {
  id          String @id
  name        String
  category    String
  tags        String
  rank        Int
  growth      Float
  votes       Int
  rating      Float
  saves       Int
  url         String
  description String
  pricing     String
  visits      String
  addedDate   String
}

model ToolHistory {
  id       String   @id @default(cuid())
  userId   String
  toolId   String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool     Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
  @@index([toolId])
}

// ---- Module: Collections ----

enum CreatorType {
  EDITORIAL
  COMMUNITY
}

model Collection {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  isFeatured  Boolean     @default(false)
  isCurated   Boolean     @default(false)
  creatorType CreatorType @default(COMMUNITY)
  toolCount   Int         @default(0)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories       CollectionCategory[]
  tools            CollectionTool[]
  relatedModels    CollectionModel[]
  relatedCompanies CollectionCompany[]
  bookmarks        CollectionBookmark[]

  @@index([creatorId])
  @@index([isFeatured])
  @@index([updatedAt])
}

model CollectionCategory {
  id           String @id @default(cuid())
  categoryName String

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([categoryName])
}

model CollectionTool {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  toolId String
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([collectionId, toolId])
}

model CollectionModel {
  id String @id @default(cuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  modelId String
  model   AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([collectionId, modelId])
}

model CollectionCompany {
  id String @id @default(cuid())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([collectionId, companyId])
}

model CollectionBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
}

// ---- Module: Tasks ----

enum TaskDifficulty {
  EASY
  MEDIUM
  ADVANCED
}

model Task {
  id           String         @id @default(cuid())
  slug         String         @unique
  title        String
  description  String
  difficulty   TaskDifficulty @default(EASY)
  pricingModel PricingModel   @default(FREE)
  isFeatured   Boolean        @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  creatorId String?
  creator   User?   @relation("TaskCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  bookmarks   TaskBookmark[]
  likes       TaskLike[]
  subscribers TaskSubscriber[]
  tools       TaskTool[]
  models      TaskModel[]
  robots      TaskRobot[]
  devices     TaskDevice[]
  resources   TaskResource[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([pricingModel])
  @@index([isFeatured])
  @@index([creatorId])
}

model TaskLike {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskSubscriber {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskSubscriberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskModel {
  taskId  String
  modelId String

  task  Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  model AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([taskId, modelId])
  @@index([modelId])
}

model TaskRobot {
  taskId  String
  robotId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  robot Robot @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@id([taskId, robotId])
  @@index([robotId])
}

model TaskDevice {
  taskId   String
  deviceId String

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([taskId, deviceId])
  @@index([deviceId])
}

model TaskResource {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  url       String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskTool {
  taskId String
  toolId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([taskId, toolId])
  @@index([toolId])
}

model TaskBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Report {
  id        String   @id @default(cuid())
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  reportedUserId String?
  reportedUser   User?   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  reportedToolId String?
  reportedTool   Tool?   @relation(fields: [reportedToolId], references: [id], onDelete: Cascade)

  reportedNewsId String?
  reportedNews   News?   @relation(fields: [reportedNewsId], references: [id], onDelete: Cascade)
}

model MCPDirectoryReport {
  id        String   @id @default(cuid())
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  reportedMCPItemId String
  reportedMCPItem   MCPItem @relation(fields: [reportedMCPItemId], references: [id], onDelete: Cascade)

  reason     String
  description String?

  @@index([reportedMCPItemId])
  @@index([reporterId])
}

model LinkBookmark {
  id        String   @id @default(cuid())
  title     String?
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- MCP Directory Platform Models ----

enum MCPItemType {
  SERVER
  CLIENT
}

enum MCPPricingType {
  FREE
  FREEMIUM
  PAID
}

enum BillingCycle {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum EditorialGrade {
  AA
  A_PLUS
  A
  B_PLUS
  B
  C
}

model MCPItem {
  id                    String            @id @default(cuid())
  itemType              MCPItemType
  name                  String
  slug                  String            @unique
  logoUrl               String?
  coverImageUrl          String?
  shortDescription      String
  fullDescription       String
  providerName          String
  providerUrl           String?
  license               String?
  pricingType           MCPPricingType    @default(FREE)
  startingPrice         Decimal?          @db.Decimal(10, 2)
  isFeatured            Boolean           @default(false)
  isVerified            Boolean           @default(false)
  launchDate            DateTime?
  lastUpdatedDate       DateTime          @default(now())
  websiteUrl            String?
  documentationUrl      String?
  repositoryUrl         String?
  qualityScore          Float?            @default(0)
  easeOfUseScore        Float?            @default(0)
  globalRank            Int?
  leaderboardRank       Int?
  editorialVerdict      String?
  viewCount             Int               @default(0)
  monthlyVisits         Int               @default(0)
  upvoteCount           Int               @default(0)
  saveCount             Int               @default(0)
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relations
  categories            MCPItemCategory[]
  subCategories         MCPItemSubCategory[]
  tags                  MCPItemTag[]
  technicalSpecs        TechnicalSpec[]
  installationGuides    InstallationGuide[]
  features              MCPFeature[]
  useCases              MCPUseCase[]
  pricingPlans          PricingPlan[]
  reviews               MCPDirectoryReview[]
  editorialReviews      MCPDirectoryEditorialReview[]
  discussions           MCPDirectoryDiscussion[]
  faqs                  MCPDirectoryFAQ[]
  upvotes               MCPDirectoryUpvote[]
  savedItems            MCPDirectorySavedMCP[]
  claims                MCPDirectoryClaim[]
  reports               MCPDirectoryReport[]

  @@index([itemType])
  @@index([slug])
  @@index([pricingType])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([viewCount])
  @@index([lastUpdatedDate])
  @@index([qualityScore])
  @@index([monthlyVisits])
  @@index([upvoteCount])
}

model MCPDirectoryCategory {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  icon        String?
  color       String?

  mcpItems MCPItemCategory[]
  subCategories MCPDirectorySubCategory[]

  @@index([slug])
}

model MCPDirectorySubCategory {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  categoryId  String
  category    MCPDirectoryCategory @relation(fields: [categoryId], references: [id])

  mcpItems MCPItemSubCategory[]

  @@unique([slug, categoryId])
  @@index([categoryId])
}

model MCPDirectoryTag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  mcpItems MCPItemTag[]

  @@index([slug])
}

model MCPItemCategory {
  id        String @id @default(cuid())
  mcpItemId String
  categoryId String

  mcpItem MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)
  category MCPDirectoryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([mcpItemId, categoryId])
  @@index([categoryId])
}

model MCPItemSubCategory {
  id           String @id @default(cuid())
  mcpItemId    String
  subCategoryId String

  mcpItem    MCPItem    @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)
  subCategory MCPDirectorySubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([mcpItemId, subCategoryId])
  @@index([subCategoryId])
}

model MCPItemTag {
  id        String @id @default(cuid())
  mcpItemId String
  tagId     String

  mcpItem MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)
  tag     MCPDirectoryTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([mcpItemId, tagId])
  @@index([tagId])
}

model TechnicalSpec {
  id             String   @id @default(cuid())
  mcpItemId      String
  supportedPlatforms String[]
  compatibility  String
  integrations   String[]
  localBindingControls String

  mcpItem MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  @@index([mcpItemId])
}

model InstallationGuide {
  id          String   @id @default(cuid())
  mcpItemId   String
  stepNumber  Int
  title       String
  codeSnippet String
  instructions String

  mcpItem MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  @@unique([mcpItemId, stepNumber])
  @@index([mcpItemId])
}

model MCPFeature {
  id          String   @id @default(cuid())
  mcpItemId   String
  title       String
  icon        String?
  description String
  badge       String?

  mcpItem MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  @@index([mcpItemId])
}

model MCPUseCase {
  id          String   @id @default(cuid())
  mcpItemId   String
  title       String
  description String
  applications String[]

  mcpItem MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  @@index([mcpItemId])
}

model PricingPlan {
  id          String       @id @default(cuid())
  mcpItemId   String
  planName    String
  price       Decimal      @db.Decimal(10, 2)
  billingCycle BillingCycle @default(MONTHLY)
  featuresList String[]

  mcpItem MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  @@index([mcpItemId])
}

model MCPDirectoryReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mcpItemId String
  mcpItem   MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mcpItemId, userId])
  @@index([mcpItemId])
  @@index([userId])
}

model MCPDirectoryEditorialReview {
  id          String         @id @default(cuid())
  grade       EditorialGrade
  verdict     String
  reviewDate  DateTime       @default(now())
  badge       String?
  notes       String?

  mcpItemId String
  mcpItem   MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  @@index([mcpItemId])
}

model MCPDirectoryDiscussion {
  id        String   @id @default(cuid())
  title     String
  content   String
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mcpItemId String
  mcpItem   MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  replies   MCPDirectoryDiscussionReply[]

  @@index([mcpItemId])
  @@index([userId])
}

model MCPDirectoryDiscussionReply {
  id        String   @id @default(cuid())
  content   String
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discussionId String
  discussion   MCPDirectoryDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([userId])
}

model MCPDirectoryFAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mcpItemId String
  mcpItem   MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  @@index([mcpItemId])
}

model MCPDirectoryUpvote {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  mcpItemId String
  mcpItem   MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mcpItemId, userId])
  @@index([mcpItemId])
  @@index([userId])
}

model MCPDirectorySavedMCP {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  mcpItemId String
  mcpItem   MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mcpItemId, userId])
  @@index([mcpItemId])
  @@index([userId])
}

model MCPDirectoryClaim {
  id          String   @id @default(cuid())
  name        String
  email       String
  relationship String
  message     String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mcpItemId String
  mcpItem   MCPItem @relation(fields: [mcpItemId], references: [id], onDelete: Cascade)

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mcpItemId])
  @@index([userId])
}
