generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tools     Tool[]
  models    AIModel[]
}

model User {
  id                                 String           @id @default(cuid())
  name                               String?
  email                              String           @unique
  createdAt                          DateTime         @default(now())
  updatedAt                          DateTime         @default(now()) @updatedAt
  emailVerified                      DateTime?
  image                              String?
  password                           String?
  role                               String           @default("USER")
  status                             String           @default("ACTIVE")
  accounts                           Account[]
  bookmarks                          Bookmark[]
  Report_Report_reportedUserIdToUser Report[]         @relation("Report_reportedUserIdToUser")
  Report_Report_reporterIdToUser     Report[]         @relation("Report_reporterIdToUser")
  reviews                            Review[]
  sessions                           Session[]
  Task                               Task[]
  TaskBookmark                       TaskBookmark[]
  TaskLike                           TaskLike[]
  TaskSubscriber                     TaskSubscriber[]
  ToolHistory                        ToolHistory[]
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  role      String   @default("USER")
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  reviews   Review[]
  bookmarks Bookmark[]
  accounts  Account[]
  sessions  Session[]
  taskBookmarks TaskBookmark[] 
  tasksCreated      Task[]           @relation("TaskCreator")
  taskLikes         TaskLike[]       @relation("TaskLikeUser")
  taskSubscriptions TaskSubscriber[] @relation("TaskSubscriberUser")
}

model Tool {
  id               String           @id @default(cuid())
  name             String
  description      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  avgRating        Float            @default(0)
  billingFrequency BillingFrequency @default(NA)
  companyId        String?
  features         String[]         @default([])
  logoUrl          String?
  pricingAmount    Decimal?         @db.Decimal(10, 2)
  pricingModel     PricingModel
  reviewCount      Int              @default(0)
  screenshots      String[]         @default([])
  slug             String           @unique
  websiteUrl       String
  bookmarks        Bookmark[]
  Report           Report[]
  reviews          Review[]
  TaskTool         TaskTool[]
  company          Company?         @relation(fields: [companyId], references: [id])
  categories       ToolCategory[]
  ToolCollection   ToolCollection[]
  ToolHistory      ToolHistory[]
  tags             ToolTag[]
  Tool_A           Tool[]           @relation("ToolAlternatives")
  Tool_B           Tool[]           @relation("ToolAlternatives")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  categories ToolCategory[]
  tags       ToolTag[]

  reviews   Review[]
  bookmarks Bookmark[]

  alternatives  Tool[] @relation("ToolAlternatives")
  alternativeOf Tool[] @relation("ToolAlternatives")
  ttasks TaskTool[]

  // Denormalized for fast listing-page sort/display. Recomputed by the
  // reviews API on every create/update/delete — see lib/reviews.ts.
  avgRating   Float @default(0)
  reviewCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([companyId])
  @@index([pricingModel])
  @@index([createdAt])
  @@index([avgRating])
}

model Category {
  id    String         @id @default(cuid())
  slug  String         @unique
  name  String
  Task  Task[]
  tools ToolCategory[]
  tasks Task[]
}

model Tag {
  id    String    @id @default(cuid())
  slug  String    @unique
  name  String
  tools ToolTag[]
}

model ToolCategory {
  toolId     String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([toolId, categoryId])
  @@index([categoryId])
}

model ToolTag {
  toolId String
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([toolId, tagId])
  @@index([tagId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  toolId    String
  userId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
  @@index([rating])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([toolId, userId])
  @@index([toolId])
  @@index([userId])
}

model AIModel {
  id            String      @id @default(cuid())
  name          String
  creator       String
  contextWindow String
  parameterSize String
  modality      String
  releaseDate   String
  description   String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  TaskModel     TaskModel[]
  providerId    String?
  provider      Company?    @relation(fields: [providerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  tasks TaskModel[]
}

  @@index([providerId])
}

model Publisher {
  id               String   @id @default(cuid())
  name             String
  domain           String   @unique
  website          String
  logoUrl          String?
  faviconUrl       String?
  colorHex         String?
  followersLabel   String?
  credibilityScore Float    @default(0.8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  articles         News[]

  @@index([name])
}

model Topic {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  articles  News[]   @relation("NewsToTopic")
}

model News {
  id          String         @id @default(cuid())
  title       String
  category    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  aiSummary   String
  articleUrl  String         @unique
  dek         String
  downvotes   Int            @default(0)
  filterTags  String[]       @default([])
  publisherId String
  slug        String         @unique
  upvotes     Int            @default(0)
  publishedAt DateTime
  publisher   Publisher      @relation(fields: [publisherId], references: [id])
  bookmarks   NewsBookmark[]
  comments    NewsComment[]
  votes       NewsVote[]
  Report      Report[]
  topics      Topic[]        @relation("NewsToTopic")

  @@index([publishedAt])
  @@index([publisherId])
  @@index([category])
}

model NewsBookmark {
  id        String   @id @default(cuid())
  articleId String
  clientId  String
  createdAt DateTime @default(now())
  article   News     @relation(fields: [articleId], references: [id])

  @@unique([articleId, clientId])
}

model NewsVote {
  id        String   @id @default(cuid())
  articleId String
  clientId  String
  value     Int
  createdAt DateTime @default(now())
  article   News     @relation(fields: [articleId], references: [id])

  @@unique([articleId, clientId])
}

model NewsComment {
  id         String   @id @default(cuid())
  articleId  String
  clientId   String
  authorName String   @default("Anonymous")
  body       String
  createdAt  DateTime @default(now())
  article    News     @relation(fields: [articleId], references: [id])

  @@index([articleId])
}

model Repository {
  id              String    @id @default(cuid())
  name            String
  owner           String
  stars           Int
  language        String?
  description     String?
  url             String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  brandColor      String?
  defaultBranch   String    @default("main")
  forks           Int
  githubCreatedAt DateTime
  githubId        Int       @unique
  homepage        String?
  license         String?
  logoUrl         String?
  openIssues      Int
  ownerAvatarUrl  String?
  readmeFetchedAt DateTime?
  readmeHtml      String?
  slug            String    @unique
  syncedAt        DateTime
  topics          String[]

  @@index([language])
  @@index([stars])
  @@index([syncedAt])
  @@index([topics], type: Gin)
  id               String    @id @default(cuid())
  githubId         Int       @unique
  slug             String    @unique
  name             String
  owner            String
  ownerAvatarUrl   String?
  description      String?
  url              String
  homepage         String?
  language         String?
  license          String?
  topics           String[]
  stars            Int
  forks            Int
  openIssues       Int
  defaultBranch    String    @default("main")
  logoUrl          String?
  brandColor       String?
  readmeHtml       String?
  readmeFetchedAt  DateTime?
  githubCreatedAt  DateTime
  syncedAt         DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([stars])
  @@index([language])
  @@index([topics], type: Gin)
  @@index([syncedAt])
}

// Synced from live production DB via `prisma db pull` on 2026-07-19 — this
// model was migrated directly to prod by another module without ever being
// committed here. Kept verbatim; not owned by this module, do not alter.
model Video {
  id              String   @id @default(cuid())
  title           String
  publishedAt     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  accent          String
  authorAvatar    String
  authorName      String
  description     String
  durationSeconds Int
  likes           Int
  slug            String   @unique
  publishedAt     String   // ISO date, YYYY-MM-DD (slice(0,10) at ingest time)
  authorName      String
  authorAvatar    String
  channelId       String?
  tags            String[] @default([])
  thumbnail       String
  toolCategory    String
  toolName        String
  youtubeId       String   @unique
  views           Int
  channelId       String?

  @@index([toolCategory])
  @@index([publishedAt])
  @@index([views])
}

model Robot {
  id           String      @id @default(cuid())
  name         String
  category     String
  manufacturer String
  year         String
  description  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  TaskRobot    TaskRobot[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  tasks TaskRobot[]
}

model Device {
  id           String       @id @default(cuid())
  name         String
  category     String
  manufacturer String
  year         String
  description  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  TaskDevice   TaskDevice[]
}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  tasks TaskDevice[]
}// ---- Auth Module ----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LeaderboardCompany {
  id            String @id
  name          String
  rank          Int
  growth        Float
  funding       String
  headquarters  String
  productsCount Int
  modelsCount   Int
  votes         Int
  rating        Float
  saves         Int
  description   String
  visits        String
}

model LeaderboardModel {
  id             String  @id
  name           String
  provider       String
  category       String
  rank           Int
  growth         Float
  contextWindow  String
  pricing        String
  eloRating      Int
  benchmarkScore Float
  openSource     Boolean
  votes          Int
  rating         Float
  saves          Int
  description    String
  visits         String
}

model LeaderboardTool {
  id          String @id
  name        String
  category    String
  tags        String
  rank        Int
  growth      Float
  votes       Int
  rating      Float
  saves       Int
  url         String
  description String
  pricing     String
  visits      String
  addedDate   String
}

model Task {
  id             String           @id
  slug           String           @unique
  title          String
  description    String
  difficulty     TaskDifficulty   @default(EASY)
  pricingModel   PricingModel     @default(FREE)
  isFeatured     Boolean          @default(false)
  categoryId     String
  creatorId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())
  Category       Category         @relation(fields: [categoryId], references: [id])
  User           User?            @relation(fields: [creatorId], references: [id])
  TaskBookmark   TaskBookmark[]
  TaskDevice     TaskDevice[]
  TaskLike       TaskLike[]
  TaskModel      TaskModel[]
  TaskResource   TaskResource[]
  TaskRobot      TaskRobot[]
  TaskSubscriber TaskSubscriber[]
  TaskTool       TaskTool[]

  @@index([categoryId])
  @@index([creatorId])
  @@index([difficulty])
  @@index([isFeatured])
  @@index([pricingModel])
}

model TaskBookmark {
  id        String   @id
  createdAt DateTime @default(now())
  taskId    String
  userId    String
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model TaskDevice {
  taskId   String
  deviceId String
  Device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  Task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, deviceId])
  @@index([deviceId])
}

model TaskLike {
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
// ---- Module: Tasks ----

enum TaskDifficulty {
  EASY
  MEDIUM
  ADVANCED
}

model Task {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String
  difficulty  TaskDifficulty @default(EASY)
  pricingModel PricingModel  @default(FREE)
  isFeatured  Boolean        @default(false)

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  creatorId   String?
  creator     User?    @relation("TaskCreator", fields: [creatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  bookmarks   TaskBookmark[]
  likes       TaskLike[]
  subscribers TaskSubscriber[]
  tools       TaskTool[]
  models      TaskModel[]
  robots      TaskRobot[]
  devices     TaskDevice[]
  resources   TaskResource[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([pricingModel])
  @@index([isFeatured])
  @@index([creatorId])
}

model TaskLike {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskSubscriber {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskSubscriberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskModel {
  taskId  String
  modelId String
  AIModel AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  Task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  model   AIModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([taskId, modelId])
  @@index([modelId])
}

model TaskResource {
  id        String   @id
  taskId    String
  title     String
  url       String
  createdAt DateTime @default(now())
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskRobot {
  taskId  String
  robotId String
  Robot   Robot  @relation(fields: [robotId], references: [id], onDelete: Cascade)
  Task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
model TaskRobot {
  taskId  String
  robotId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  robot Robot @relation(fields: [robotId], references: [id], onDelete: Cascade)

  @@id([taskId, robotId])
  @@index([robotId])
}

model TaskSubscriber {
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  Task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
model TaskDevice {
  taskId   String
  deviceId String

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([taskId, deviceId])
  @@index([deviceId])
}

model TaskResource {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  url       String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskTool {
  taskId String
  toolId String
  Task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  Tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([taskId, toolId])
  @@index([toolId])
}

model Collection {
  id             String           @id
  slug           String           @unique
  title          String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())
  ToolCollection ToolCollection[]
}

model Report {
  id                               String   @id
  reason                           String
  status                           String   @default("PENDING")
  reporterId                       String
  reportedUserId                   String?
  reportedToolId                   String?
  reportedNewsId                   String?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @default(now())
  News                             News?    @relation(fields: [reportedNewsId], references: [id])
  Tool                             Tool?    @relation(fields: [reportedToolId], references: [id])
  User_Report_reportedUserIdToUser User?    @relation("Report_reportedUserIdToUser", fields: [reportedUserId], references: [id])
  User_Report_reporterIdToUser     User     @relation("Report_reporterIdToUser", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
}

model ToolCollection {
  toolId       String
  collectionId String
  Collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  Tool         Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([toolId, collectionId])
  @@index([collectionId])
}

model ToolHistory {
  id       String   @id
  userId   String
  toolId   String
  viewedAt DateTime @default(now())
  Tool     Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([toolId])
  @@index([userId])
}

enum PricingModel {
  FREE
  FREEMIUM
  PAID
  FREE_TRIAL
}

enum BillingFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
  NA
}

enum TaskDifficulty {
  EASY
  MEDIUM
  ADVANCED
}
model TaskBookmark {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}
